{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [],
  "env": {
    "PROJECT_ROOT": "$PWD/.."
  },
  "shell": {
    "init_hook": [
      "echo 'Welcome to devbox!' > /dev/null",
      "if [ -z \"${TALOSCONFIG}\" ]; then",
      "  if [ -n \"${TALOSCONFIG_TEXT}\" ]; then",
      "    export TALOSCONFIG=/tmp/talosconfig",
      "    echo -n \"${TALOSCONFIG_TEXT}\" > \"${TALOSCONFIG}\"",
      "    echo \"Using TALOSCONFIG_TEXT to create ${TALOSCONFIG}\"",
      "  else",
      "    echo \"TALOSCONFIG not found and TALOSCONFIG_TEXT not defined\"",
      "  fi",
      "fi",
      // the hashicorp/helm provider uses KUBE_CONFIG_PATH instead of the (established) KUBECONFIG env var
      //  This logic cannot be consolidated into the plugin, as the plugin's init_hook is evaluated _before_ this one is
      "export KUBE_CONFIG_PATH=\"${KUBECONFIG:-}\"",
    ]
  },
  "include": [ "path:../devbox-plugins/common/plugin.json" ]
}
  
