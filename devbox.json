{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    "age@1.3.1",
    "cosign@3.0.4",
    "gitsign@0.14.0",
    "sops@3.11.0",
    "hubble@1.18.6",
    "cilium-cli@0.19.0",
    "fluxcd@2.7.5",
  ],
  "env": {
    // avoid the need to choose our oauth when using sigstore
    "GITSIGN_CONNECTOR_ID": "https://github.com/login/oauth",
  },
  "shell": {
    "init_hook": [
      // We will only set SOPS_AGE_KEY_FILE *IF* SOPS_AGE_KEY is not defined (which it is in our github action)
      "test -z \"${SOPS_AGE_KEY}\" && export SOPS_AGE_KEY_FILE=${SOPS_AGE_KEY_FILE:-$PWD/terraform/github/secrets/secret.key}",
      "export TALOSCONFIG=${TALOSCONFIG:-$PWD/terraform/github/secrets/development-talos/TALOSCONFIG_TEXT.raw}",
      "export KUBECONFIG=${KUBECONFIG:-$PWD/terraform/github/secrets/development-k8s/KUBECONFIG_TEXT.raw}",
      // the hashicorp/helm provider uses KUBE_CONFIG_PATH instead of the (established) KUBECONFIG env var
      //  This logic cannot be consolidated into the plugin, as the plugin's init_hook is evaluated _before_ this one is
      "export KUBE_CONFIG_PATH=\"${KUBECONFIG}\"",
      "echo 'Welcome to devbox!' > /dev/null",
    ],
    "scripts": {
      "test2": [
        "echo \"Error: no test specified\" && exit 1",
      ],
      "renovate": [
        // export GITHUB_COM_TOKEN=github_pat_XXXX
        "docker run -it --rm -v $PWD:/repo -w /repo -e GITHUB_COM_TOKEN=${GITHUB_COM_TOKEN:-} -e LOG_LEVEL=debug renovate/renovate:latest --platform=local --repository-cache=reset \"${@}\"",
      ],
      "kiro-cli": [
        // installation was clunky:
        //   I launched a docker image, ran `apt install curl ca-certificates unzip --no-install-recommends` then copied $HOME/.local/bin /code/.local/bin
        //
        // authentication was clunky (a browser is needed), so I just ran
        // devbox shell && export HOME=$(pwd) && firefox & && ./.local/bin/kiro-cli login
        //
        // TODO:  Maybe try to create a custom Dockerfile via devbox
        //
        "docker run -it --rm --env HOME=/code --env PATH=/code/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin --workdir=/code --user $(id -u):$(id -g) -v $PWD:/code ubuntu:20.04 kiro-cli chat --agent infra-tdd",
      ],
      // Sourcing secrets has gotten redundant and complicated enough, we
      //   want to move this into our devbox setup.  However, we want to
      //   make sure it is NOT ran by our GHA.
      "github-tf": [
        "set -a",
        "source <(sops -d ${PROJECT_ROOT}/terraform/github/secrets/shared/cloudflare.sops.env)",
        "source <(sops -d ${PROJECT_ROOT}/terraform/github/secrets/curator-github/tfstate.sops.env)",
        "set +a",
        "tofu -chdir=\"${PROJECT_ROOT}/terraform/github\" \"${@}\"",
      ],
      "k8s-tf": [
        "set -a",
        "source <(sops -d ${PROJECT_ROOT}/terraform/github/secrets/shared/cloudflare.sops.env)",
        "source <(sops -d ${PROJECT_ROOT}/terraform/github/secrets/development-k8s/tfstate.sops.env)",
        "source <(sops -d ${PROJECT_ROOT}/terraform/github/secrets/development-k8s/tfvars.sops.env)",
        "source <(sops -d ${PROJECT_ROOT}/terraform/github/secrets/development-k8s/tfcluster.sops.env)",
        "export TF_VAR_flux_age=$(sops -d ${PROJECT_ROOT}/terraform/github/secrets/development-k8s/TF_VAR_flux_age.sops.raw)",
        "export TF_VAR_flux_known_hosts=$(sops -d ${PROJECT_ROOT}/terraform/github/secrets/development-k8s/TF_VAR_flux_known_hosts.sops.raw)",
        "export TF_VAR_flux_private_key=$(sops -d ${PROJECT_ROOT}/terraform/github/secrets/development-k8s/TF_VAR_flux_private_key.sops.raw)",
        "set +a",
        "tofu -chdir=\"${PROJECT_ROOT}/terraform/k8s\" \"${@}\"",
      ],
      "talos-tf": [
        "set -a",
        "source <(sops -d ${PROJECT_ROOT}/terraform/github/secrets/shared/cloudflare.sops.env)",
        "source <(sops -d ${PROJECT_ROOT}/terraform/github/secrets/development-talos/tfstate.sops.env)",
        "source <(sops -d ${PROJECT_ROOT}/terraform/github/secrets/development-talos/tfvars.sops.env)",
        "source <(sops -d ${PROJECT_ROOT}/terraform/github/secrets/development-talos/tfcluster.sops.env)",
        "set +a",
        "tofu -chdir=\"${PROJECT_ROOT}/terraform/talos\" \"${@}\"",
      ],
      "talos-spec": [
        // Since talos-spec needs access to S3, we need to expand the credentials
        "set -a",
        "source <(sops -d ${PROJECT_ROOT}/terraform/github/secrets/shared/cloudflare.sops.env)",
        "source <(sops -d ${PROJECT_ROOT}/terraform/github/secrets/development-talos/tfstate.sops.env)",
        "set +a",
        "env | grep AWS",
        "shellspec \"${PROJECT_ROOT}/terraform/talos\" --format documentation \"${@}\""
      ],
      // Some tools to diagnose flux
      "flux-check-all": [
        "flux get all -A",
      ],
      "flux-check-failed": [
        "flux get all -A --status-selector ready=false",
      ],
    },
  },
  "include": ["path:./devbox-plugins/common/plugin.json"],
}
