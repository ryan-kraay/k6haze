{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    "age@1.2.1",
    "cosign@3.0.3",
    "gitsign@0.13.0",
    "sops@3.11.0",
    "hubble@1.18.3",
    "cilium-cli@0.18.8",
  ],
  "env": {
    // avoid the need to choose our oauth when using sigstore
    "GITSIGN_CONNECTOR_ID": "https://github.com/login/oauth",
  },
  "shell": {
    "init_hook": [
      // We will only set SOPS_AGE_KEY_FILE *IF* SOPS_AGE_KEY is not defined (which it is in our github action)
      "test -z \"${SOPS_AGE_KEY}\" && export SOPS_AGE_KEY_FILE=${SOPS_AGE_KEY_FILE:-$PWD/terraform/github/secrets/secret.key}",
      "export TALOSCONFIG=${TALOSCONFIG:-$PWD/terraform/github/secrets/development-talos/TALOSCONFIG_TEXT.raw}",
      "export KUBECONFIG=${KUBECONFIG:-$PWD/terraform/github/secrets/development-k8s/KUBECONFIG_TEXT.raw}",
      // the hashicorp/helm provider uses KUBE_CONFIG_PATH instead of the (established) KUBECONFIG env var
      //  This logic cannot be consolidated into the plugin, as the plugin's init_hook is evaluated _before_ this one is
      "export KUBE_CONFIG_PATH=\"${KUBECONFIG}\"",
      "echo 'Welcome to devbox!' > /dev/null",
    ],
    "scripts": {
      "test2": [
        "echo \"Error: no test specified\" && exit 1",
      ],
      "renovate": [
        // export GITHUB_COM_TOKEN=github_pat_XXXX
        "docker run -it --rm -v $PWD:/repo -w /repo -e GITHUB_COM_TOKEN=${GITHUB_COM_TOKEN:-} -e LOG_LEVEL=debug renovate/renovate:latest --platform=local --repository-cache=reset \"${@}\"",
      ],
      "kiro-cli": [
        // installation was clunky:
        //   I launched a docker image, ran `apt install curl ca-certificates unzip --no-install-recommends` then copied $HOME/.local/bin /code/.local/bin
        //
        // authentication was clunky (a browser is needed), so I just ran
        // devbox shell && export HOME=$(pwd) && firefox & && ./.local/bin/kiro-cli login
        //
        // TODO:  Maybe try to create a custom Dockerfile via devbox
        //
        "docker run -it --rm --env HOME=/code --env PATH=/code/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin --workdir=/code --user $(id -u):$(id -g) -v $PWD:/code ubuntu:20.04 kiro-cli chat --agent infra-tdd",
      ],
    },
  },
  "include": ["path:./devbox-plugins/common/plugin.json"],
}
