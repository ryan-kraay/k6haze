{
  "name": "k6haze-common",
  "version": "0.0.1",
  "description": "A list of tools shared between the k6haze development and automatic testing pipelines.",
  "packages": [
    "kubectl@1.35.3",
    "kubernetes-helm@3.20.1",
    "opentofu@1.11.6",
    "rclone@1.73.4",
    "shellspec@0.28.1",
    "talosctl@1.12.6",
    "yq-go@4.53.2",
  ],
  "env": {
    "PROJECT_ROOT": "{{.DevboxProjectDir}}"
  },
  "shell": {
    "scripts": {
      "test": [
        // by default shellspec will traverse and find *all* spec files
        "shellspec -c \"${PROJECT_ROOT}/spec\" --format documentation \"${@}\""
      ],
      "github-tf": [
        "tofu -chdir=\"${PROJECT_ROOT}/terraform/github\" \"${@}\""
      ],
      "github-spec": [
        "shellspec \"${PROJECT_ROOT}/terraform/github\"  --format documentation \"${@}\""
      ],
      "k8s-tf": [
        "tofu -chdir=\"${PROJECT_ROOT}/terraform/k8s\" \"${@}\""
      ],
      "k8s-spec": [
        "shellspec \"${PROJECT_ROOT}/terraform/k8s\"  --format documentation \"${@}\""
      ],
      "talos-tf": [
        "tofu -chdir=\"${PROJECT_ROOT}/terraform/talos\" \"${@}\""
      ],
      "talos-spec": [
        "shellspec \"${PROJECT_ROOT}/terraform/talos\" --format documentation \"${@}\""
      ]
    }
  }
}
