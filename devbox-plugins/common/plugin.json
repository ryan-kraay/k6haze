{
  "name": "k6haze-common",
  "version": "0.0.1",
  "description": "A list of tools shared between the k6haze development and automatic testing pipelines.",
  "packages": [
    "opentofu@1.10.7",
    "shellspec@0.28.1"
  ],
  "env": {
    "PROJECT_ROOT": "{{.DevboxProjectDir}}"
  },
  "shell": {
    "scripts": {
      "test": [
        "shellspec --format documentation \"${PROJECT_ROOT}\" \"${@}\""
      ],
      "github-tf": [
        "tofu -chdir=\"${PROJECT_ROOT}/terraform/github\" \"${@}\""
      ],
      "github-spec": [
        "shellspec --format documentation \"${PROJECT_ROOT}/terraform/github/spec\" \"${@}\""
      ],
      "k8s-tf": [
        "tofu -chdir=\"${PROJECT_ROOT}/terraform/k8s\" \"${@}\""
      ],
      "k8s-spec": [
        "shellspec --format documentation \"${PROJECT_ROOT}/terraform/k8s/spec\" \"${@}\""
      ],
      "talos-tf": [
        "tofu -chdir=\"${PROJECT_ROOT}/terraform/talos\" \"${@}\""
      ],
      "talos-spec": [
        "shellspec --format documentation \"${PROJECT_ROOT}/terraform/talos/spec\" \"${@}\""
      ]
    }
  }
}
